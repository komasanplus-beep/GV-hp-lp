{
  "name": "HotelContent",
  "type": "object",
  "properties": {
    "section": {
      "type": "string",
      "enum": [
        "about",
        "facility",
        "gallery",
        "testimonial",
        "settings"
      ]
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "rating": {
      "type": "number"
    },
    "author": {
      "type": "string"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "section"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}