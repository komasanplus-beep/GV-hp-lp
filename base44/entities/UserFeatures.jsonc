{
  "name": "UserFeatures",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "dashboard": {
      "type": "boolean",
      "default": true
    },
    "site_manage": {
      "type": "boolean",
      "default": false,
      "description": "\u30db\u30fc\u30e0\u30da\u30fc\u30b8\u7ba1\u7406"
    },
    "lp_manage": {
      "type": "boolean",
      "default": false,
      "description": "LP\u7ba1\u7406"
    },
    "blog_manage": {
      "type": "boolean",
      "default": false,
      "description": "\u30d6\u30ed\u30b0\u7ba1\u7406"
    },
    "ai_generate": {
      "type": "boolean",
      "default": false,
      "description": "AI\u751f\u6210"
    },
    "seo_manage": {
      "type": "boolean",
      "default": false,
      "description": "SEO\u7ba1\u7406"
    },
    "domain_manage": {
      "type": "boolean",
      "default": false,
      "description": "\u30c9\u30e1\u30a4\u30f3\u8a2d\u5b9a"
    },
    "reservation_manage": {
      "type": "boolean",
      "default": false,
      "description": "\u4e88\u7d04\u7ba1\u7406\uff08\u5c06\u6765\uff09"
    },
    "ec_manage": {
      "type": "boolean",
      "default": false,
      "description": "EC\u7ba1\u7406\uff08\u5c06\u6765\uff09"
    },
    "member_manage": {
      "type": "boolean",
      "default": false,
      "description": "\u4f1a\u54e1\u7ba1\u7406\uff08\u5c06\u6765\uff09"
    },
    "analytics": {
      "type": "boolean",
      "default": false,
      "description": "\u30a2\u30af\u30bb\u30b9\u89e3\u6790\uff08\u5c06\u6765\uff09"
    },
    "settings": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}