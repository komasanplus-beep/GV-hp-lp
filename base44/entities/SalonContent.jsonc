{
  "name": "SalonContent",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "\u30de\u30eb\u30c1\u30c6\u30ca\u30f3\u30c8\u7528\u30e6\u30fc\u30b6\u30fcID"
    },
    "site_id": {
      "type": "string",
      "description": "\u7d10\u4ed8\u3051\u30b5\u30a4\u30c8ID"
    },
    "section": {
      "type": "string",
      "enum": [
        "about",
        "menu",
        "staff",
        "gallery",
        "voice",
        "campaign"
      ]
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "price": {
      "type": "string"
    },
    "staff_name": {
      "type": "string"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "section"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}